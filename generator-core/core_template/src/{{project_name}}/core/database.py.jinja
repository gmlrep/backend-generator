from collections.abc import AsyncGenerator
from contextlib import asynccontextmanager

from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker, create_async_engine
from sqlalchemy.orm import DeclarativeBase
from sqlalchemy.pool import StaticPool

from {{project_name}}.core.config import settings


class AsyncSessionLocal(AsyncSession):
    def __repr__(self) -> str:
        return f"<{self.__class__.__name__}>"


class Base(DeclarativeBase):
    pass


class Database:
    def __init__(self, db_url: str | None = None) -> None:
        url = db_url or settings.database.db_url

        engine_kwargs: dict = {"echo": settings.database.echo, "pool_pre_ping": True}
        if url.startswith("sqlite"):
            # SQLite (used by the test suite) needs a single shared connection.
            engine_kwargs["poolclass"] = StaticPool
            engine_kwargs["connect_args"] = {"check_same_thread": False}
        else:
            engine_kwargs.update(
                pool_size=settings.database.POOL_SIZE,
                max_overflow=settings.database.POOL_OVERFLOW,
                pool_timeout=settings.database.POOL_TIMEOUT,
            )

        self._async_engine = create_async_engine(url, **engine_kwargs)

        self._async_session_factory = async_sessionmaker(
            class_=AsyncSessionLocal,
            bind=self._async_engine,
            expire_on_commit=False,
        )

    @property
    def engine(self):
        return self._async_engine

    @asynccontextmanager
    async def session(self) -> AsyncGenerator[AsyncSession]:
        async with self._async_session_factory() as session:
            yield session

    async def dispose(self) -> None:
        await self._async_engine.dispose()

import sys
from typing import Any

from loguru import logger

from {{project_name}}.core.config import settings


def logger_patcher(record: Any) -> None:
    """Ensure every record has the fields used by the log format."""
    record["extra"].setdefault("request_id", "n/a")


def logger_add() -> None:
    logger.remove()
    # Apply the patcher to the *global* loguru logger so records emitted via
    # ``from loguru import logger`` also get ``extra[request_id]``.
    logger.configure(patcher=logger_patcher)
    logger.add(
        sys.stdout,
        format=settings.loguru.format,
        level=settings.loguru.level,
        backtrace=True,
        diagnose=not settings.is_production,
    )

    if settings.is_production:
        logger.add(
            "logs/app.log",
            rotation="10 MB",
            retention="30 days",
            format=settings.loguru.format,
            level="WARNING",
        )

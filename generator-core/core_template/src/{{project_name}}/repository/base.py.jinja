from collections.abc import Callable
from contextlib import AbstractAsyncContextManager
from typing import Any

from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

from {{project_name}}.model.base_model import BaseModel
from {{project_name}}.util.query_builder import build_query

SessionFactory = Callable[[], AbstractAsyncContextManager[AsyncSession]]


class BaseRepository[ModelType: BaseModel]:
    model: type[ModelType]

    def __init__(self, session_factory: SessionFactory) -> None:
        self.session_factory = session_factory

    async def create(self, obj: ModelType) -> ModelType:
        async with self.session_factory() as session:
            session.add(obj)
            await session.commit()
            await session.refresh(obj)
            return obj

    async def read_by_id(self, id: int) -> ModelType | None:
        async with self.session_factory() as session:
            stmt = select(self.model).where(self.model.id == id)
            result = await session.execute(stmt)
            return result.scalar_one_or_none()

    async def read_by_options(self, schema) -> dict[str, Any]:
        async with self.session_factory() as session:
            stmt = build_query(self.model, schema)
            result = await session.execute(stmt)
            founds = result.scalars().all()
            return {"founds": list(founds)}

    async def update_by_id(self, id: int, obj: dict[str, Any]) -> ModelType | None:
        async with self.session_factory() as session:
            db_obj = await self.read_by_id(id)
            if not db_obj:
                return None
            for key, value in obj.items():
                setattr(db_obj, key, value)
            await session.commit()
            await session.refresh(db_obj)
            return db_obj

    async def delete_by_id(self, id: int) -> bool:
        async with self.session_factory() as session:
            db_obj = await self.read_by_id(id)
            if not db_obj:
                return False
            await session.delete(db_obj)
            await session.commit()
            return True

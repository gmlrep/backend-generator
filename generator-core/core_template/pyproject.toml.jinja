[project]
name = "{{project_name}}"
version = "0.1.0"
description = "FastAPI microservice generated by backend-service-generator."
readme = "README.md"
requires-python = ">=3.12"
dependencies = [
    "alembic>=1.19",
    "asyncpg>=0.31",
    "dependency-injector>=4.49.1",
    "fastapi>=0.141",
    "loguru>=0.7.3",
    "pydantic>=2.13",
    "pydantic-settings>=2.15",
    "python-dotenv>=1.2",
    "sqlalchemy[asyncio]>=2.0.52",
    "uvicorn[standard]>=0.52",
]

[project.scripts]
{{project_name}} = "{{project_name}}.__main__:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{project_name}}"]

[dependency-groups]
dev = [
    "aiosqlite>=0.20",
    "httpx>=0.28.1",
    "mypy>=1.19",
    "polyfactory>=3.2",
    "pytest>=9.0.2",
    "pytest-asyncio>=1.4",
    "pytest-cov>=7.0",
    "ruff>=0.15",
    "schemathesis>=4.0",
    "testcontainers[postgres]>=4.14",
]

[tool.ruff]
target-version = "py312"
line-length = 120

[tool.ruff.lint]
select = ["E", "F", "I", "B", "UP", "ASYNC", "C4"]
ignore = ["B008"]

[tool.ruff.format]
quote-style = "double"

[tool.mypy]
python_version = "3.12"
ignore_missing_imports = true
warn_return_any = false
check_untyped_defs = true
plugins = ["pydantic.mypy"]

[tool.pytest.ini_options]
pythonpath = ["src"]
filterwarnings = [
    "ignore::DeprecationWarning",
    # Expected in tests: the default development JWT secret is short.
    "ignore:The HMAC key is .*:UserWarning",
]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
testpaths = ["tests"]
markers = [
    "contract: OpenAPI contract tests (schemathesis)",
    "migration: database migration / schema compatibility tests",
    "testcontainers: tests that require Docker and start their own database",
]

[tool.coverage.run]
source = ["src/{{project_name}}"]
omit = [
    "src/{{project_name}}/__main__.py",
    "src/{{project_name}}/seed.py",
    "migrations/*",
]

[tool.coverage.report]
show_missing = true
exclude_lines = [
    "pragma: no cover",
    "if TYPE_CHECKING:",
    "raise NotImplementedError",
]

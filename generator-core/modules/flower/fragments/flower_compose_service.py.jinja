  flower:
    build: .
    command:
      - "celery"
      - "-A"
      - "{{project_name}}.infrastructure.celery.app:celery_app"
      - "flower"
      - "--port=5555"
      - "--basic_auth=${FLOWER_BASIC_AUTH:?Set FLOWER_BASIC_AUTH in .env}"
    env_file:
      - .env
    environment:
      - POSTGRES_HOST=db
      - POSTGRES_PORT=5432
      - CELERY_BROKER_URL=redis://redis:6379/0
      - CELERY_RESULT_BACKEND=redis://redis:6379/1
      - RUN_MIGRATIONS=false
    ports:
      - "${FLOWER_PORT:-5555}:5555"
    depends_on:
      redis:
        condition: service_healthy

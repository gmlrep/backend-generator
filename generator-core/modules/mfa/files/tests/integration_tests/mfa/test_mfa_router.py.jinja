import pyotp
from httpx import AsyncClient


async def _auth_headers(client: AsyncClient, email: str = "mfa@test.io") -> dict[str, str]:
    await client.post("/api/v1/auth/sign-up", json={"email": email, "password": "password1", "name": "MFA"})
    sign_in = await client.post("/api/v1/auth/sign-in", json={"email": email, "password": "password1"})
    return {"Authorization": f"Bearer {sign_in.json()['access_token']}"}


async def test_mfa_totp_flow(client: AsyncClient) -> None:
    headers = await _auth_headers(client)

    status = await client.get("/api/v1/auth/mfa/status", headers=headers)
    assert status.json()["is_enabled"] is False

    setup = await client.post("/api/v1/auth/mfa/setup", headers=headers)
    assert setup.status_code == 200, setup.text
    secret = setup.json()["secret"]

    code = pyotp.TOTP(secret).now()
    enabled = await client.post("/api/v1/auth/mfa/enable", json={"code": code}, headers=headers)
    assert enabled.status_code == 200, enabled.text
    assert enabled.json()["is_enabled"] is True

    # Password-only sign-in must challenge once MFA is enabled.
    challenge = await client.post("/api/v1/auth/sign-in", json={"email": "mfa@test.io", "password": "password1"})
    assert challenge.status_code == 200, challenge.text
    body = challenge.json()
    assert body["mfa_required"] is True
    assert body["mfa_token"]
    assert body["access_token"] is None

    mfa_code = pyotp.TOTP(secret).now()
    completed = await client.post(
        "/api/v1/auth/sign-in/mfa",
        json={"mfa_token": body["mfa_token"], "code": mfa_code},
    )
    assert completed.status_code == 200, completed.text
    assert completed.json()["access_token"]

    disable_code = pyotp.TOTP(secret).now()
    disabled = await client.post(
        "/api/v1/auth/mfa/disable",
        json={"code": disable_code},
        headers={"Authorization": f"Bearer {completed.json()['access_token']}"},
    )
    assert disabled.status_code == 200, disabled.text
    assert disabled.json()["is_enabled"] is False


async def test_mfa_rejects_invalid_code(client: AsyncClient) -> None:
    headers = await _auth_headers(client, email="mfa2@test.io")
    await client.post("/api/v1/auth/mfa/setup", headers=headers)

    response = await client.post("/api/v1/auth/mfa/enable", json={"code": "000000"}, headers=headers)

    assert response.status_code == 401

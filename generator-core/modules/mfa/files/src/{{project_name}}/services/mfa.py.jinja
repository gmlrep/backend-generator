import base64
import hashlib
import secrets

import pyotp
from cryptography.fernet import Fernet, InvalidToken

from {{project_name}}.adapters.email.interface import EmailSender
from {{project_name}}.core.config import settings
from {{project_name}}.core.exceptions import AuthError, NotFoundError
from {{project_name}}.model.mfa import MfaCredential
from {{project_name}}.repository.mfa import MfaRepository
from {{project_name}}.schema.mfa import MfaSetupResponse
from {{project_name}}.schema.user import User
from {{project_name}}.services.base import BaseService
from {{project_name}}.services.mfa_code_store import MfaCodeStore


def _fernet() -> Fernet:
    raw = settings.mfa.ENCRYPTION_KEY or settings.security.JWT_SECRET
    digest = hashlib.sha256(raw.encode("utf-8")).digest()
    return Fernet(base64.urlsafe_b64encode(digest))


def _encrypt_secret(secret: str) -> str:
    return _fernet().encrypt(secret.encode("utf-8")).decode("utf-8")


def _decrypt_secret(payload: str) -> str:
    try:
        return _fernet().decrypt(payload.encode("utf-8")).decode("utf-8")
    except InvalidToken as exc:
        raise AuthError("Invalid MFA credential") from exc


class MfaService(BaseService):
    def __init__(self, mfa_repository: MfaRepository, email_sender: EmailSender, code_store: MfaCodeStore) -> None:
        self.mfa_repository = mfa_repository
        self.email_sender = email_sender
        self.code_store = code_store
        super().__init__(mfa_repository)

    async def status(self, user_id: int) -> bool:
        credential = await self.mfa_repository.read_by_user_id(user_id)
        return bool(credential and credential.is_enabled)

    async def setup(self, user: User) -> MfaSetupResponse:
        secret = pyotp.random_base32()
        encrypted = _encrypt_secret(secret)
        credential = await self.mfa_repository.read_by_user_id(user.id)
        if credential is None:
            credential = MfaCredential(user_id=user.id, secret=encrypted, is_enabled=False)
            await self.mfa_repository.create(credential)
        else:
            await self.mfa_repository.update_by_id(credential.id, {"secret": encrypted, "is_enabled": False})

        totp = pyotp.TOTP(secret, interval=settings.mfa.TOTP_INTERVAL)
        return MfaSetupResponse(
            secret=secret,
            otpauth_url=totp.provisioning_uri(name=user.email, issuer_name=settings.mfa.ISSUER),
        )

    async def enable(self, user_id: int, code: str) -> bool:
        credential = await self.mfa_repository.read_by_user_id(user_id)
        if credential is None:
            raise NotFoundError("MFA is not set up")
        plain = _decrypt_secret(credential.secret)
        if not self._verify_totp(plain, code):
            raise AuthError("Invalid MFA code")
        await self.mfa_repository.update_by_id(credential.id, {"is_enabled": True})
        return True

    async def disable(self, user_id: int, code: str) -> None:
        credential = await self.mfa_repository.read_by_user_id(user_id)
        if credential is None:
            raise NotFoundError("MFA is not set up")
        plain = _decrypt_secret(credential.secret)
        if not self._verify_totp(plain, code):
            raise AuthError("Invalid MFA code")
        await self.mfa_repository.update_by_id(credential.id, {"is_enabled": False})

    async def verify_totp(self, user_id: int, code: str) -> None:
        credential = await self.mfa_repository.read_by_user_id(user_id)
        if credential is None or not credential.is_enabled:
            raise AuthError("MFA is not enabled")
        plain = _decrypt_secret(credential.secret)
        if not self._verify_totp(plain, code):
            raise AuthError("Invalid MFA code")

    async def send_email_code(self, user: User) -> None:
        code = f"{secrets.randbelow(10 ** settings.mfa.CODE_LENGTH):0{settings.mfa.CODE_LENGTH}d}"
        await self.code_store.set_code(user.id, code, ttl_seconds=settings.mfa.CODE_TTL_SECONDS)
        await self.email_sender.send(
            to=user.email,
            subject="Your verification code",
            body=f"Your verification code is {code}.",
        )

    async def verify_email_code(self, user_id: int, code: str) -> bool:
        stored = await self.code_store.get_code(user_id)
        if stored is None or not secrets.compare_digest(stored, code):
            raise AuthError("Invalid verification code")
        await self.code_store.delete_code(user_id)
        credential = await self.mfa_repository.read_by_user_id(user_id)
        if credential is None:
            raise NotFoundError("MFA is not set up")
        await self.mfa_repository.update_by_id(credential.id, {"is_enabled": True})
        return True

    def _verify_totp(self, secret: str, code: str) -> bool:
        return pyotp.TOTP(secret, interval=settings.mfa.TOTP_INTERVAL).verify(code, valid_window=1)

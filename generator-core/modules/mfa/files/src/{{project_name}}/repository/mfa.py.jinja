from sqlalchemy import select

from {{project_name}}.model.mfa import MfaCredential
from {{project_name}}.repository.base import BaseRepository


class MfaRepository(BaseRepository[MfaCredential]):
    model = MfaCredential

    async def read_by_user_id(self, user_id: int) -> MfaCredential | None:
        async with self.session_factory() as session:
            stmt = select(MfaCredential).where(MfaCredential.user_id == user_id)
            result = await session.execute(stmt)
            return result.scalar_one_or_none()

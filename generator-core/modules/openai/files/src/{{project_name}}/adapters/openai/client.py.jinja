from openai import AsyncOpenAI


class OpenAITextGenerator:
    """``TextGenerator`` backed by the OpenAI SDK.

    ``base_url`` makes it work with any OpenAI-compatible service (Azure,
    Ollama, vLLM, ...).
    """

    def __init__(self, api_key: str, base_url: str | None = None, model: str = "gpt-4o-mini") -> None:
        self.model = model
        self._client = AsyncOpenAI(api_key=api_key or "not-set", base_url=base_url)

    async def generate(self, prompt: str, *, system: str | None = None) -> str:
        messages: list[dict[str, str]] = []
        if system:
            messages.append({"role": "system", "content": system})
        messages.append({"role": "user", "content": prompt})

        response = await self._client.chat.completions.create(model=self.model, messages=messages)  # type: ignore[arg-type]
        return response.choices[0].message.content or ""

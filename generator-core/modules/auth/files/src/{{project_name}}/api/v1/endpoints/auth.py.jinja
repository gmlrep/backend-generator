from typing import Annotated

from dependency_injector.wiring import Provide, inject
from fastapi import APIRouter, Depends
from fastapi.security import OAuth2PasswordRequestForm

from {{project_name}}.core.container import Container
from {{project_name}}.core.dependencies import get_current_active_user
from {{project_name}}.core.security import JWTBearer
from {{project_name}}.schema.auth import MfaSignInRequest, RefreshRequest, SignIn, SignInResponse, SignUp
from {{project_name}}.schema.user import User
from {{project_name}}.services.auth import AuthService

router = APIRouter(prefix="/auth", tags=["auth"])


@router.post("/sign-in", response_model=SignInResponse)
@inject
async def sign_in(
    user_info: SignIn,
    service: Annotated[AuthService, Depends(Provide[Container.auth_service])],
) -> SignInResponse:
    return await service.sign_in(user_info)


@router.post("/sign-in/mfa", response_model=SignInResponse)
@inject
async def sign_in_mfa(
    payload: MfaSignInRequest,
    service: Annotated[AuthService, Depends(Provide[Container.auth_service])],
) -> SignInResponse:
    return await service.complete_mfa_sign_in(payload.mfa_token, payload.code)


@router.post("/token", response_model=SignInResponse)
@inject
async def token(
    form_data: Annotated[OAuth2PasswordRequestForm, Depends()],
    service: Annotated[AuthService, Depends(Provide[Container.auth_service])],
) -> SignInResponse:
    """OAuth2 password flow endpoint (``application/x-www-form-urlencoded``)."""
    return await service.sign_in_oauth(form_data)


@router.post("/refresh", response_model=SignInResponse)
@inject
async def refresh(
    payload: RefreshRequest,
    service: Annotated[AuthService, Depends(Provide[Container.auth_service])],
) -> SignInResponse:
    return await service.refresh(payload.refresh_token)


@router.post("/logout", status_code=204)
@inject
async def logout(
    payload: RefreshRequest,
    service: Annotated[AuthService, Depends(Provide[Container.auth_service])],
    access_token: Annotated[str | None, Depends(JWTBearer(auto_error=False))] = None,
) -> None:
    await service.logout(payload.refresh_token, access_token=access_token)


@router.post("/sign-up", response_model=User)
@inject
async def sign_up(
    user_info: SignUp,
    service: Annotated[AuthService, Depends(Provide[Container.auth_service])],
) -> User:
    return await service.sign_up(user_info)


@router.get("/me", response_model=User)
async def get_me(current_user: Annotated[User, Depends(get_current_active_user)]) -> User:
    return current_user

from datetime import timedelta

from {{project_name}}.core.config import settings
from {{project_name}}.core.exceptions import AuthError
from {{project_name}}.core.security import create_access_token, get_password_hash, verify_password
from {{project_name}}.model.user import User as UserModel
from {{project_name}}.repository.user import UserRepository
from {{project_name}}.schema.auth import Payload, SignIn, SignInResponse, SignUp
from {{project_name}}.schema.user import FindUser, User
from {{project_name}}.services.base import BaseService
from {{project_name}}.util.hash import get_rand_hash


class AuthService(BaseService):
    def __init__(self, user_repository: UserRepository) -> None:
        self.user_repository = user_repository
        super().__init__(user_repository)

    async def sign_in(self, sign_in_info: SignIn) -> SignInResponse:
        find_user = FindUser(email__eq=sign_in_info.email)
        users: list[UserModel] = (await self.user_repository.read_by_options(find_user))["founds"]
        if len(users) < 1:
            raise AuthError(detail="Incorrect email or password")

        found_user = users[0]
        if not found_user.is_active:
            raise AuthError(detail="Account is not active")
        if not await verify_password(sign_in_info.password, found_user.password):
            raise AuthError(detail="Incorrect email or password")

        payload = Payload(
            id=found_user.id,
            email=found_user.email,
            name=found_user.name,
            is_superuser=found_user.is_superuser,
        )
        token_lifespan = timedelta(minutes=settings.security.JWT_EXPIRES_MINUTES)
        access_token, expiration_datetime = create_access_token(payload.model_dump(), token_lifespan)
        return SignInResponse(
            access_token=access_token,
            expiration=expiration_datetime,
            user_info=User.model_validate(found_user),
        )

    async def sign_up(self, user_info: SignUp) -> User:
        user = UserModel(
            email=user_info.email,
            name=user_info.name,
            is_active=True,
            is_superuser=False,
            user_token=get_rand_hash(),
            password=await get_password_hash(user_info.password),
        )
        created_user: UserModel = await self.user_repository.create(user)
        return User.model_validate(created_user)

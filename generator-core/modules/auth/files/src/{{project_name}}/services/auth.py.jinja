from datetime import UTC, datetime, timedelta

from fastapi import HTTPException
from fastapi.security import OAuth2PasswordRequestForm

from {{project_name}}.core.config import settings
from {{project_name}}.core.exceptions import AuthError
from {{project_name}}.core.security import (
    ACCESS_TOKEN_TYPE,
    MFA_TOKEN_TYPE,
    REFRESH_TOKEN_TYPE,
    create_access_token,
    create_mfa_token,
    create_refresh_token,
    decode_jwt,
    get_password_hash,
    verify_password,
)
from {{project_name}}.model.user import User as UserModel
from {{project_name}}.repository.user import UserRepository
from {{project_name}}.schema.auth import Payload, SignIn, SignInResponse, SignUp
from {{project_name}}.schema.user import FindUser, User
from {{project_name}}.services.base import BaseService
from {{project_name}}.services.token_store import TokenStore
from {{project_name}}.util.hash import get_rand_hash


class AuthService(BaseService):
    def __init__(
        self,
        user_repository: UserRepository,
        token_store: TokenStore,
        mfa_service: object | None = None,
    ) -> None:
        self.user_repository = user_repository
        self.token_store = token_store
        self.mfa_service = mfa_service
        super().__init__(user_repository)

    async def authenticate(self, email: str, password: str) -> User:
        find_user = FindUser(email__eq=email)
        users: list[UserModel] = (await self.user_repository.read_by_options(find_user))["founds"]
        if len(users) < 1:
            raise AuthError(detail="Incorrect email or password")

        found_user = users[0]
        if not found_user.is_active:
            raise AuthError(detail="Account is not active")
        if not await verify_password(password, found_user.password):
            raise AuthError(detail="Incorrect email or password")
        return User.model_validate(found_user)

    async def _mfa_enabled(self, user_id: int) -> bool:
        if self.mfa_service is None:
            return False
        return bool(await self.mfa_service.status(user_id))  # type: ignore[attr-defined]

    async def sign_in(self, sign_in_info: SignIn) -> SignInResponse:
        user = await self.authenticate(sign_in_info.email, sign_in_info.password)
        if await self._mfa_enabled(user.id):
            payload = Payload(id=user.id, email=user.email, name=user.name, is_superuser=user.is_superuser)
            mfa_token, _, _ = create_mfa_token(payload.model_dump())
            return SignInResponse(mfa_required=True, mfa_token=mfa_token, user_info=user)
        return await self.issue_tokens(user)

    async def complete_mfa_sign_in(self, mfa_token: str, code: str) -> SignInResponse:
        if self.mfa_service is None:
            raise AuthError(detail="MFA is not configured")
        try:
            payload = decode_jwt(mfa_token, expected_type=MFA_TOKEN_TYPE)
        except HTTPException as exc:
            raise AuthError(detail="Invalid MFA token") from exc

        user_id = int(payload["id"])
        if not await self.mfa_service.status(user_id):  # type: ignore[attr-defined]
            raise AuthError(detail="MFA is not enabled for this user")
        await self.mfa_service.verify_totp(user_id, code)  # type: ignore[attr-defined]

        user_model = await self.user_repository.read_by_id(user_id)
        if user_model is None or not user_model.is_active:
            raise AuthError(detail="Inactive user")
        return await self.issue_tokens(User.model_validate(user_model))

    async def sign_in_oauth(self, form_data: OAuth2PasswordRequestForm) -> SignInResponse:
        return await self.sign_in(SignIn(email=form_data.username, password=form_data.password))

    async def sign_up(self, user_info: SignUp) -> User:
        user = UserModel(
            email=user_info.email,
            name=user_info.name,
            is_active=True,
            is_superuser=False,
            user_token=get_rand_hash(),
            password=await get_password_hash(user_info.password),
        )
        created_user: UserModel = await self.user_repository.create(user)
        return User.model_validate(created_user)

    async def refresh(self, refresh_token: str) -> SignInResponse:
        try:
            payload = decode_jwt(refresh_token, expected_type=REFRESH_TOKEN_TYPE)
        except HTTPException as exc:
            raise AuthError(detail="Invalid refresh token") from exc

        jti = payload.get("jti")
        if not jti or not await self.token_store.is_refresh_valid(jti):
            raise AuthError(detail="Refresh token has been revoked")
        await self.token_store.revoke_refresh(jti)

        user_model = await self.user_repository.read_by_id(int(payload["id"]))
        if user_model is None or not user_model.is_active:
            raise AuthError(detail="Inactive user")
        return await self.issue_tokens(User.model_validate(user_model))

    async def logout(self, refresh_token: str, access_token: str | None = None) -> None:
        try:
            payload = decode_jwt(refresh_token, expected_type=REFRESH_TOKEN_TYPE)
        except HTTPException:
            payload = {}
        jti = payload.get("jti")
        if jti:
            await self.token_store.revoke_refresh(jti)

        if access_token:
            try:
                access_payload = decode_jwt(access_token, expected_type=ACCESS_TOKEN_TYPE)
            except HTTPException:
                return
            access_jti = access_payload.get("jti")
            if access_jti:
                exp = access_payload.get("exp")
                ttl = 1
                if isinstance(exp, (int, float)):
                    ttl = max(int(exp - datetime.now(UTC).timestamp()), 1)
                await self.token_store.revoke_access(access_jti, ttl)

    async def issue_tokens(self, user: User) -> SignInResponse:
        """Issue access + refresh tokens for an authenticated user."""
        payload = Payload(id=user.id, email=user.email, name=user.name, is_superuser=user.is_superuser)
        access_token, expiration, _ = create_access_token(payload.model_dump())
        refresh_token, _, refresh_jti = create_refresh_token(payload.model_dump())

        ttl_seconds = int(timedelta(days=settings.security.JWT_REFRESH_EXPIRES_DAYS).total_seconds())
        await self.token_store.save_refresh(refresh_jti, user.id, ttl_seconds)

        return SignInResponse(
            access_token=access_token,
            refresh_token=refresh_token,
            expiration=expiration,
            user_info=user,
        )

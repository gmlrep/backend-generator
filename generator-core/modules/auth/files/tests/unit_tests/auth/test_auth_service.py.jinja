from datetime import UTC, datetime

import pytest

from {{project_name}}.core.exceptions import AuthError
from {{project_name}}.core.security import get_password_hash
from {{project_name}}.model.user import User as UserModel
from {{project_name}}.schema.auth import SignIn, SignUp
from {{project_name}}.services.auth import AuthService
from {{project_name}}.services.token_store import InMemoryTokenStore


def _user(password: str) -> UserModel:
    user = UserModel(
        email="user@test.io",
        password=password,
        user_token="tok",
        name="User",
        is_active=True,
        is_superuser=False,
    )
    user.id = 1
    now = datetime.now(UTC)
    user.created_at = now
    user.updated_at = now
    return user


class _FakeUserRepository:
    def __init__(self, found: UserModel | None = None) -> None:
        self.found = found
        self.created: UserModel | None = None

    async def read_by_options(self, schema) -> dict:
        return {"founds": [self.found] if self.found else []}

    async def read_by_id(self, id: int) -> UserModel | None:
        if self.found is not None and self.found.id == id:
            return self.found
        return None

    async def create(self, model: UserModel) -> UserModel:
        self.created = model
        model.id = 1
        return model


def _service(repository: _FakeUserRepository) -> AuthService:
    return AuthService(repository, InMemoryTokenStore())


async def test_sign_in_returns_access_and_refresh_tokens() -> None:
    hashed = await get_password_hash("plain")
    service = _service(_FakeUserRepository(found=_user(hashed)))

    result = await service.sign_in(SignIn(email="user@test.io", password="plain"))

    assert result.access_token
    assert result.refresh_token
    assert result.token_type == "bearer"
    assert result.user_info.email == "user@test.io"


async def test_sign_in_wrong_password() -> None:
    hashed = await get_password_hash("plain")
    service = _service(_FakeUserRepository(found=_user(hashed)))

    with pytest.raises(AuthError):
        await service.sign_in(SignIn(email="user@test.io", password="nope"))


async def test_sign_in_unknown_user() -> None:
    service = _service(_FakeUserRepository(found=None))

    with pytest.raises(AuthError):
        await service.sign_in(SignIn(email="nobody@test.io", password="x"))


async def test_refresh_rotates_and_revokes_old_token() -> None:
    hashed = await get_password_hash("plain")
    service = _service(_FakeUserRepository(found=_user(hashed)))
    first = await service.sign_in(SignIn(email="user@test.io", password="plain"))

    second = await service.refresh(first.refresh_token)

    assert second.access_token
    with pytest.raises(AuthError):
        await service.refresh(first.refresh_token)


async def test_logout_revokes_refresh_token() -> None:
    hashed = await get_password_hash("plain")
    service = _service(_FakeUserRepository(found=_user(hashed)))
    tokens = await service.sign_in(SignIn(email="user@test.io", password="plain"))

    await service.logout(tokens.refresh_token)

    with pytest.raises(AuthError):
        await service.refresh(tokens.refresh_token)


async def test_sign_up_hashes_password_and_sets_token() -> None:
    repository = _FakeUserRepository()
    service = _service(repository)

    created = await service.sign_up(SignUp(email="new@test.io", password="plain", name="New"))

    assert repository.created is not None
    assert repository.created.password != "plain"
    assert repository.created.user_token
    assert created.email == "new@test.io"

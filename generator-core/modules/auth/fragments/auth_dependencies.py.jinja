from typing import Annotated

import jwt
from dependency_injector.wiring import Provide, inject
from fastapi import Depends
from pydantic import ValidationError

from {{project_name}}.core.config import settings
from {{project_name}}.core.container import Container
from {{project_name}}.core.exceptions import AuthError
from {{project_name}}.core.security import JWTBearer
from {{project_name}}.schema.auth import Payload
from {{project_name}}.schema.user import User
from {{project_name}}.services.user import UserService


async def _resolve_user(token: str, service: UserService) -> User | None:
    try:
        payload = jwt.decode(
            token,
            key=settings.security.get_verification_key(),
            algorithms=[settings.security.JWT_ALGORITHM],
        )
        token_data = Payload(**payload)
    except (jwt.PyJWTError, ValidationError):
        return None
    return await service.get_by_id(token_data.id)


@inject
async def get_current_user(
    token: Annotated[str, Depends(JWTBearer())],
    service: Annotated[UserService, Depends(Provide[Container.user_service])],
) -> User:
    current_user = await _resolve_user(token, service)
    if not current_user:
        raise AuthError(detail="Could not validate credentials")
    return current_user


async def get_current_active_user(current_user: Annotated[User, Depends(get_current_user)]) -> User:
    if not current_user.is_active:
        raise AuthError(detail="Inactive user")
    return current_user


@inject
async def get_current_user_with_no_exception(
    token: Annotated[str, Depends(JWTBearer())],
    service: Annotated[UserService, Depends(Provide[Container.user_service])],
) -> User | None:
    return await _resolve_user(token, service)


async def get_current_super_user(current_user: Annotated[User, Depends(get_current_user)]) -> User:
    if not current_user.is_active:
        raise AuthError(detail="Inactive user")
    if not current_user.is_superuser:
        raise AuthError(detail="It's not a super user")
    return current_user

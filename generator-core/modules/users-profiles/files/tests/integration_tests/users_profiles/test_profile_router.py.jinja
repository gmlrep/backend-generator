from httpx import AsyncClient


async def _auth_headers(client: AsyncClient) -> dict[str, str]:
    await client.post("/api/v1/auth/sign-up", json={"email": "profile@test.io", "password": "plain", "name": "P"})
    sign_in = await client.post("/api/v1/auth/sign-in", json={"email": "profile@test.io", "password": "plain"})
    return {"Authorization": f"Bearer {sign_in.json()['access_token']}"}


async def test_profile_roundtrip(client: AsyncClient) -> None:
    headers = await _auth_headers(client)

    created = await client.get("/api/v1/users/me/profile", headers=headers)
    assert created.status_code == 200, created.text
    assert created.json()["locale"] == "en"

    updated = await client.put("/api/v1/users/me/profile", json={"display_name": "Ada"}, headers=headers)
    assert updated.status_code == 200, updated.text
    assert updated.json()["display_name"] == "Ada"

from {{project_name}}.model.profile import Profile
from {{project_name}}.repository.profile import ProfileRepository
from {{project_name}}.schema.profile import ProfileRead, ProfileUpdate
from {{project_name}}.services.base import BaseService


class UsersService(BaseService):
    def __init__(self, profile_repository: ProfileRepository) -> None:
        self.profile_repository = profile_repository
        super().__init__(profile_repository)

    async def get_or_create_profile(self, user_id: int) -> ProfileRead:
        profile = await self.profile_repository.read_by_user_id(user_id)
        if profile is None:
            profile = await self.profile_repository.create(Profile(user_id=user_id))
        return ProfileRead.model_validate(profile)

    async def update_profile(self, user_id: int, payload: ProfileUpdate) -> ProfileRead:
        profile = await self.profile_repository.read_by_user_id(user_id)
        if profile is None:
            profile = await self.profile_repository.create(Profile(user_id=user_id))

        updated = await self.profile_repository.update_by_id(profile.id, payload.model_dump(exclude_unset=True))
        if updated is None:
            updated = profile
        return ProfileRead.model_validate(updated)

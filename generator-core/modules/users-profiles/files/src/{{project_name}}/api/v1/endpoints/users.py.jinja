from typing import Annotated

from dependency_injector.wiring import Provide, inject
from fastapi import APIRouter, Depends

from {{project_name}}.core.container import Container
from {{project_name}}.core.dependencies import get_current_active_user
from {{project_name}}.schema.profile import ProfileRead, ProfileUpdate
from {{project_name}}.schema.user import User
from {{project_name}}.services.users import UsersService

router = APIRouter(prefix="/users", tags=["users"])


@router.get("/me/profile", response_model=ProfileRead)
@inject
async def get_my_profile(
    current_user: Annotated[User, Depends(get_current_active_user)],
    service: Annotated[UsersService, Depends(Provide[Container.users_service])],
) -> ProfileRead:
    return await service.get_or_create_profile(current_user.id)


@router.put("/me/profile", response_model=ProfileRead)
@inject
async def update_my_profile(
    payload: ProfileUpdate,
    current_user: Annotated[User, Depends(get_current_active_user)],
    service: Annotated[UsersService, Depends(Provide[Container.users_service])],
) -> ProfileRead:
    return await service.update_profile(current_user.id, payload)

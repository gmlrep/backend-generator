from __future__ import annotations

import re
from typing import Any

import aiohttp

from {{project_name}}.adapters.external_api.errors import ExternalApiError

_RESOURCE_ID_RE = re.compile(r"^[A-Za-z0-9_-]+$")


class AiohttpExternalApiClient:
    """``ExternalApiClient`` backed by ``aiohttp.ClientSession``."""

    def __init__(self, base_url: str, api_key: str = "", timeout_seconds: float = 10.0) -> None:
        self._base_url = base_url.rstrip("/")
        headers: dict[str, str] = {}
        if api_key:
            headers["Authorization"] = f"Bearer {api_key}"
        timeout = aiohttp.ClientTimeout(total=timeout_seconds)
        self._session = aiohttp.ClientSession(base_url=self._base_url, headers=headers, timeout=timeout)

    @staticmethod
    def _validate_resource_id(resource_id: str) -> str:
        if not _RESOURCE_ID_RE.match(resource_id):
            raise ExternalApiError(f"Invalid resource id '{resource_id}'")
        return resource_id

    async def get_resource(self, resource_id: str) -> dict[str, Any]:
        safe_id = self._validate_resource_id(resource_id)
        return await self._request("GET", f"/v1/resources/{safe_id}")

    async def create_resource(self, payload: dict[str, Any]) -> dict[str, Any]:
        return await self._request("POST", "/v1/resources", json=payload)

    async def aclose(self) -> None:
        if not self._session.closed:
            await self._session.close()

    async def _request(self, method: str, path: str, **kwargs: Any) -> dict[str, Any]:
        try:
            async with self._session.request(method, path, **kwargs) as response:
                text = await response.text()
                if response.status >= 400:
                    raise ExternalApiError(
                        f"External API {method} {path} failed",
                        status_code=response.status,
                        body=text[:500],
                    )
                if not text:
                    return {}
                return await response.json(content_type=None)
        except ExternalApiError:
            raise
        except aiohttp.ClientError as exc:
            raise ExternalApiError(f"External API transport error: {exc}") from exc

from typing import Any

from {{project_name}}.adapters.external_api.interface import ExternalApiClient


class ExternalApiService:
    """Thin application service over ``ExternalApiClient``."""

    def __init__(self, client: ExternalApiClient) -> None:
        self._client = client

    async def get_resource(self, resource_id: str) -> dict[str, Any]:
        return await self._client.get_resource(resource_id)

    async def create_resource(self, payload: dict[str, Any]) -> dict[str, Any]:
        return await self._client.create_resource(payload)

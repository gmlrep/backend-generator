from unittest.mock import AsyncMock, MagicMock, patch

import pytest

from {{project_name}}.adapters.external_api.client import AiohttpExternalApiClient
from {{project_name}}.adapters.external_api.errors import ExternalApiError


@pytest.mark.asyncio
async def test_get_resource_success() -> None:
    response = AsyncMock()
    response.status = 200
    response.text = AsyncMock(return_value='{"id": "1"}')
    response.json = AsyncMock(return_value={"id": "1"})
    response.__aenter__ = AsyncMock(return_value=response)
    response.__aexit__ = AsyncMock(return_value=None)

    session = MagicMock()
    session.request = MagicMock(return_value=response)
    session.closed = False
    session.close = AsyncMock()

    with patch("aiohttp.ClientSession", return_value=session):
        client = AiohttpExternalApiClient(base_url="https://api.example.com", api_key="k")
        result = await client.get_resource("1")
        assert result == {"id": "1"}
        await client.aclose()


@pytest.mark.asyncio
async def test_get_resource_rejects_path_traversal() -> None:
    with patch("aiohttp.ClientSession", return_value=MagicMock(closed=False, close=AsyncMock())):
        client = AiohttpExternalApiClient(base_url="https://api.example.com")
        with pytest.raises(ExternalApiError, match="Invalid resource id"):
            await client.get_resource("../secret")
        await client.aclose()


@pytest.mark.asyncio
async def test_get_resource_error() -> None:
    response = AsyncMock()
    response.status = 500
    response.text = AsyncMock(return_value="boom")
    response.__aenter__ = AsyncMock(return_value=response)
    response.__aexit__ = AsyncMock(return_value=None)

    session = MagicMock()
    session.request = MagicMock(return_value=response)
    session.closed = False
    session.close = AsyncMock()

    with patch("aiohttp.ClientSession", return_value=session):
        client = AiohttpExternalApiClient(base_url="https://api.example.com")
        with pytest.raises(ExternalApiError) as exc:
            await client.get_resource("1")
        assert exc.value.status_code == 500
        await client.aclose()

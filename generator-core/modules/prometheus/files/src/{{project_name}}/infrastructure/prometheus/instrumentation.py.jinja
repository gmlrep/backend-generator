from typing import Annotated

from fastapi import FastAPI, Header, HTTPException, Response
from prometheus_client import CONTENT_TYPE_LATEST, generate_latest
from prometheus_fastapi_instrumentator import Instrumentator

from {{project_name}}.core.config import settings


def setup_metrics(app: FastAPI, endpoint: str = "/metrics", token: str = "") -> None:
    """Instrument the app and expose ``endpoint``.

    When ``token`` is set, require ``Authorization: Bearer <token>``.
    When ``token`` is empty, expose only for ``local`` / ``test`` environments
    (scrape from the Compose network in other envs should set ``METRICS_TOKEN``).
    """
    Instrumentator().instrument(app)

    @app.get(endpoint, include_in_schema=False)
    async def metrics(
        authorization: Annotated[str | None, Header()] = None,
    ) -> Response:
        if token:
            if authorization != f"Bearer {token}":
                raise HTTPException(status_code=401, detail="Unauthorized")
        elif not (settings.is_local or settings.is_test):
            raise HTTPException(status_code=404, detail="Not Found")
        return Response(generate_latest(), media_type=CONTENT_TYPE_LATEST)

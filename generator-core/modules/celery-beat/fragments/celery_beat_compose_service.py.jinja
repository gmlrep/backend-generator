  beat:
    build: .
    # Schedule/pid under /tmp: image runs as non-root and /app is not writable.
    command:
      - "celery"
      - "-A"
      - "{{project_name}}.infrastructure.celery.app:celery_app"
      - "beat"
      - "-l"
      - "info"
      - "--schedule=/tmp/celerybeat-schedule"
      - "--pidfile=/tmp/celerybeat.pid"
    env_file:
      - .env
    environment:
      - POSTGRES_HOST=db
      - POSTGRES_PORT=5432
      - CELERY_BROKER_URL=redis://redis:6379/0
      - CELERY_RESULT_BACKEND=redis://redis:6379/1
      - RUN_MIGRATIONS=false
    depends_on:
      redis:
        condition: service_healthy

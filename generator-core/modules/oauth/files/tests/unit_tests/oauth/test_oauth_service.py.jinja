import pytest

from {{project_name}}.core.exceptions import AuthError
from {{project_name}}.services.oauth import OAuthService


class FakeRedis:
    def __init__(self) -> None:
        self.store: dict[str, str] = {}

    async def set(self, key: str, value: str, ttl: int | None = None) -> None:
        self.store[key] = value

    async def get(self, key: str) -> str | None:
        return self.store.get(key)

    async def delete(self, *keys: str) -> int:
        n = 0
        for key in keys:
            if key in self.store:
                del self.store[key]
                n += 1
        return n


@pytest.mark.asyncio
async def test_unknown_provider(monkeypatch) -> None:
    from {{project_name}}.core.config import settings

    monkeypatch.setattr(settings.oauth, "GOOGLE_ENABLED", True)
    svc = OAuthService(
        user_repository=None,  # type: ignore[arg-type]
        oauth_account_repository=None,  # type: ignore[arg-type]
        auth_service=None,  # type: ignore[arg-type]
        redis_client=FakeRedis(),  # type: ignore[arg-type]
    )
    with pytest.raises(AuthError):
        await svc.get_authorize_url("unknown")

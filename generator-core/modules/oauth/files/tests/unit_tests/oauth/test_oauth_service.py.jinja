@pytest.mark.asyncio
async def test_authorize_url_includes_pkce(monkeypatch) -> None:
    from {{project_name}}.core.config import settings

    monkeypatch.setattr(settings.oauth, "GOOGLE_ENABLED", True)
    monkeypatch.setattr(settings.oauth, "GOOGLE_CLIENT_ID", "cid")
    redis = FakeRedis()
    url = await _service(redis).get_authorize_url("google")
    assert "code_challenge=" in url
    assert "code_challenge_method=S256" in url
    assert redis.store
    state_payload = json.loads(next(iter(redis.store.values())))
    assert state_payload["provider"] == "google"
    assert state_payload["verifier"]



from __future__ import annotations

import base64
import hashlib
import json
import secrets
from typing import Any
from urllib.parse import urlencode

import httpx
from authlib.integrations.httpx_client import AsyncOAuth2Client

from {{project_name}}.core.config import settings
from {{project_name}}.core.exceptions import AuthError
from {{project_name}}.core.security import get_password_hash
from {{project_name}}.infrastructure.redis.client import RedisClient
from {{project_name}}.model.oauth_account import OAuthAccount
from {{project_name}}.model.user import User as UserModel
from {{project_name}}.repository.oauth_account import OAuthAccountRepository
from {{project_name}}.repository.user import UserRepository

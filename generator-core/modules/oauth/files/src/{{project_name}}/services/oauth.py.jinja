from {{project_name}}.schema.user import FindUser, User
from {{project_name}}.services.auth import AuthService
from {{project_name}}.util.hash import get_rand_hash

_PROVIDERS: dict[str, dict[str, str]] = {
    "google": {
        "authorize_url": "https://accounts.google.com/o/oauth2/v2/auth",
        "token_url": "https://oauth2.googleapis.com/token",
        "userinfo_url": "https://openidconnect.googleapis.com/v1/userinfo",
        "scope": "openid email profile",
    },
    "github": {
        "authorize_url": "https://github.com/login/oauth/authorize",
        "token_url": "https://github.com/login/oauth/access_token",
        "userinfo_url": "https://api.github.com/user",
        "scope": "read:user user:email",
    },
}

_STATE_TTL = 600
_EXCHANGE_TTL = 120


def _pkce_pair() -> tuple[str, str]:
    verifier = secrets.token_urlsafe(64)
    digest = hashlib.sha256(verifier.encode("ascii")).digest()
    challenge = base64.urlsafe_b64encode(digest).rstrip(b"=").decode("ascii")
    return verifier, challenge


class OAuthService:
    def __init__(
        self,
        *,
        user_repository: UserRepository,
        oauth_account_repository: OAuthAccountRepository,
        auth_service: AuthService,
        redis_client: RedisClient,
    ) -> None:
        self.user_repository = user_repository
        self.oauth_account_repository = oauth_account_repository
        self.auth_service = auth_service
        self.redis_client = redis_client

    def _credentials(self, provider: str) -> tuple[str, str]:
        if provider == "google":
            if not settings.oauth.GOOGLE_ENABLED:
                raise AuthError(detail="Google OAuth is disabled")
            return settings.oauth.GOOGLE_CLIENT_ID, settings.oauth.GOOGLE_CLIENT_SECRET
        if provider == "github":
            if not settings.oauth.GITHUB_ENABLED:
                raise AuthError(detail="GitHub OAuth is disabled")
            return settings.oauth.GITHUB_CLIENT_ID, settings.oauth.GITHUB_CLIENT_SECRET
        raise AuthError(detail=f"Unknown OAuth provider '{provider}'")

    def _redirect_uri(self, provider: str) -> str:
        return f"{settings.oauth.REDIRECT_BASE_URL.rstrip('/')}/api/v1/oauth/{provider}/callback"

    async def get_authorize_url(self, provider: str) -> str:
        if provider not in _PROVIDERS:
            raise AuthError(detail=f"Unknown OAuth provider '{provider}'")
        client_id, _ = self._credentials(provider)
        if not client_id:
            raise AuthError(detail=f"OAuth client id is not configured for {provider}")
        state = secrets.token_urlsafe(24)
        verifier, challenge = _pkce_pair()
        payload = json.dumps({"provider": provider, "verifier": verifier})
        await self.redis_client.set(f"oauth:state:{state}", payload, ttl=_STATE_TTL)
        cfg = _PROVIDERS[provider]
        params = {
            "client_id": client_id,
            "redirect_uri": self._redirect_uri(provider),
            "response_type": "code",
            "scope": cfg["scope"],
            "state": state,
            "code_challenge": challenge,
            "code_challenge_method": "S256",
        }
        if provider == "google":
            params["access_type"] = "online"
            params["include_granted_scopes"] = "true"
        return f"{cfg['authorize_url']}?{urlencode(params)}"

    async def handle_callback(self, provider: str, *, code: str, state: str) -> SignInResponse:
        raw = await self.redis_client.getdel(f"oauth:state:{state}")
        if not raw:
            raise AuthError(detail="Invalid OAuth state")
        try:
            stored = json.loads(raw)
        except json.JSONDecodeError as exc:
            raise AuthError(detail="Invalid OAuth state") from exc
        if stored.get("provider") != provider:
            raise AuthError(detail="Invalid OAuth state")
        verifier = stored.get("verifier")
        if not verifier:
            raise AuthError(detail="Invalid OAuth state")

        client_id, client_secret = self._credentials(provider)
        cfg = _PROVIDERS[provider]
        async with AsyncOAuth2Client(client_id, client_secret) as client:
            token = await client.fetch_token(
                cfg["token_url"],
                code=code,
                redirect_uri=self._redirect_uri(provider),
                grant_type="authorization_code",
                code_verifier=verifier,
            )
        profile = await self._fetch_profile(provider, token)
        user = await self._upsert_user(provider, profile)
        return await self.auth_service.issue_tokens(user)

    async def create_exchange_code(self, tokens: SignInResponse) -> str:
        exchange = secrets.token_urlsafe(32)
        payload = tokens.model_dump(mode="json")
        await self.redis_client.set(f"oauth:exchange:{exchange}", json.dumps(payload), ttl=_EXCHANGE_TTL)
        return exchange

    async def exchange_code(self, code: str) -> SignInResponse:
        raw = await self.redis_client.getdel(f"oauth:exchange:{code}")
        if not raw:
            raise AuthError(detail="Invalid or expired OAuth exchange code")
        try:
            data = json.loads(raw)
        except json.JSONDecodeError as exc:
            raise AuthError(detail="Invalid or expired OAuth exchange code") from exc
        return SignInResponse.model_validate(data)

    async def _fetch_profile(self, provider: str, token: dict[str, Any]) -> dict[str, str]:
        access_token = token.get("access_token")
        if not access_token:
            raise AuthError(detail="OAuth token exchange failed")
        headers = {"Authorization": f"Bearer {access_token}"}
        async with httpx.AsyncClient() as http:
            if provider == "google":
                resp = await http.get(_PROVIDERS["google"]["userinfo_url"], headers=headers)
                resp.raise_for_status()
                data = resp.json()
                if data.get("email_verified") is not True:
                    raise AuthError(detail="OAuth email is not verified")
                email = data.get("email")
                if not email:
                    raise AuthError(detail="OAuth provider did not return an email")
                return {
                    "provider_user_id": str(data["sub"]),
                    "email": email,
                    "name": data.get("name") or email,
                }
            resp = await http.get(_PROVIDERS["github"]["userinfo_url"], headers=headers)
            resp.raise_for_status()
            data = resp.json()
            email = None
            emails_resp = await http.get("https://api.github.com/user/emails", headers=headers)
            if emails_resp.status_code == 200:
                for item in emails_resp.json():
                    if item.get("primary") and item.get("verified") and item.get("email"):
                        email = item["email"]
                        break
                if not email:
                    for item in emails_resp.json():
                        if item.get("verified") and item.get("email"):
                            email = item["email"]
                            break
            if not email:
                raise AuthError(detail="OAuth email is not verified")
            return {
                "provider_user_id": str(data["id"]),
                "email": email,
                "name": data.get("name") or data.get("login") or email,
            }

    async def _upsert_user(self, provider: str, profile: dict[str, str]) -> User:
        email = profile["email"]
        if email.lower().endswith(".oauth.local"):
            raise AuthError(detail="Synthetic OAuth emails are not allowed")

        existing = (
            await self.oauth_account_repository.read_by_options(
                FindOAuthAccount(provider__eq=provider, provider_user_id__eq=profile["provider_user_id"])
            )
        )["founds"]
        if existing:
            user_model = await self.user_repository.read_by_id(existing[0].user_id)
            if user_model is None or not user_model.is_active:
                raise AuthError(detail="Inactive user")
            return User.model_validate(user_model)

        users = (await self.user_repository.read_by_options(FindUser(email__eq=email)))["founds"]
        if users:
            raise AuthError(
                detail="An account with this email already exists. Sign in and link OAuth from your account settings."
            )

        user_model = UserModel(
            email=email,
            password=await get_password_hash(secrets.token_urlsafe(32)),
            user_token=get_rand_hash(),
            name=profile["name"],
            is_active=True,
            is_superuser=False,
        )
        user_model = await self.user_repository.create(user_model)
        account = OAuthAccount(
            user_id=user_model.id,
            provider=provider,
            provider_user_id=profile["provider_user_id"],
            email=email,
        )
        await self.oauth_account_repository.create(account)
        return User.model_validate(user_model)

from sqlalchemy import insert, select

from {{project_name}}.core.exceptions import NotFoundError
from {{project_name}}.model.permission import Permission
from {{project_name}}.model.role import Role, role_permissions, user_roles
from {{project_name}}.repository.permission import PermissionRepository
from {{project_name}}.repository.role import RoleRepository
from {{project_name}}.schema.role import AssignRoleRequest, RoleCreate, RoleRead
from {{project_name}}.services.base import BaseService


class PermissionService(BaseService):
    def __init__(self, role_repository: RoleRepository, permission_repository: PermissionRepository) -> None:
        self.role_repository = role_repository
        self.permission_repository = permission_repository
        super().__init__(role_repository)

    @property
    def session_factory(self):  # type: ignore[no-untyped-def]
        return self.role_repository.session_factory

    async def get_permission_codes(self, user_id: int) -> list[str]:
        async with self.session_factory() as session:
            stmt = (
                select(Permission.code)
                .join(role_permissions, role_permissions.c.permission_id == Permission.id)
                .join(user_roles, user_roles.c.role_id == role_permissions.c.role_id)
                .where(user_roles.c.user_id == user_id)
            )
            result = await session.execute(stmt)
            return list(result.scalars().all())

    async def has_permission(self, user_id: int, code: str) -> bool:
        return code in await self.get_permission_codes(user_id)

    async def assign_role(self, payload: AssignRoleRequest) -> None:
        role = await self.role_repository.read_by_name(payload.role)
        if role is None:
            raise NotFoundError("Role not found")
        async with self.session_factory() as session:
            await session.execute(insert(user_roles).values(user_id=payload.user_id, role_id=role.id))
            await session.commit()

    async def create_role(self, payload: RoleCreate) -> RoleRead:
        role = await self.role_repository.read_by_name(payload.name)
        if role is None:
            role = await self.role_repository.create(Role(name=payload.name, description=payload.description))

        for code in payload.permissions:
            permission = await self.permission_repository.read_by_code(code)
            if permission is None:
                permission = await self.permission_repository.create(Permission(code=code))
            async with self.session_factory() as session:
                await session.execute(
                    insert(role_permissions).values(role_id=role.id, permission_id=permission.id)
                )
                await session.commit()

        return RoleRead(id=role.id, name=role.name, description=role.description, permissions=payload.permissions)

    async def list_roles(self) -> list[RoleRead]:
        result = await self.role_repository.read_by_options(None)
        return [RoleRead.model_validate(role) for role in result["founds"]]
